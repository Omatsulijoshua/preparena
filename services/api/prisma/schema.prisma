generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONTENT_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  APPLE
}

enum QuestionType {
  OBJECTIVE
  THEORY
  ESSAY
  PRACTICAL
  COMPREHENSION
  DIAGRAM
  IMAGE
  TABLE
  MATHEMATICAL_EXPRESSION
  AUDIO
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum ExamMode {
  PRACTICE
  TOPIC_PRACTICE
  TIMED_PRACTICE
  FULL_CBT
  DAILY_CHALLENGE
  MISTAKE_CORRECTION
  CUSTOM_TEST
  MULTIPLAYER
  SCHOOL_ASSIGNED
}

enum SubscriptionPlan {
  FREE
  WEEKLY
  MONTHLY
  ANNUAL
  FAMILY
  SCHOOL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
  GRACE_PERIOD
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
  GOOGLE_PLAY
  APPLE_IAP
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum MistakeCategory {
  KNOWLEDGE_GAP
  CALCULATION_ERROR
  QUESTION_MISINTERPRETATION
  TIME_PRESSURE
  GUESSING
  CARELESS_MISTAKE
  CHANGED_CORRECT_ANSWER
}

enum AIfeature {
  QUESTION_EXPLANATION
  PERSONAL_TUTOR
  PERFORMANCE_ANALYSIS
  WEAKNESS_IDENTIFICATION
  STUDY_PLAN
  REVISION_NOTE
  FLASHCARD
  SIMILAR_QUESTION
  QUESTION_GENERATION
  THEORY_MARKING
  ESSAY_MARKING
  HANDWRITING_ANALYSIS
  READINESS_PREDICTION
  VOICE_TUTOR
}

model User {
  id              String      @id @default(uuid())
  email           String?     @unique
  phone           String?     @unique
  passwordHash    String?
  firstName       String
  lastName        String
  avatar          String?
  role            Role        @default(STUDENT)
  isEmailVerified Boolean     @default(false)
  isPhoneVerified Boolean     @default(false)
  authProvider    AuthProvider @default(EMAIL)
  providerId      String?
  refreshToken    String?
  deviceSessions  Json?
  lastLoginAt     DateTime?
  isSuspended     Boolean     @default(false)
  suspensionReason String?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  studentProfile    StudentProfile?
  parentChildren    ParentChild[]       @relation("ParentChild")
  childParent       ParentChild[]       @relation("ChildParent")
  teacherClasses    Class[]
  schoolMemberships SchoolMember[]
  attempts          Attempt[]
  results           Result[]
  subscriptions     Subscription[]
  payments          Payment[]
  studyPlans        StudyPlan[]
  bookmarks         Bookmark[]
  notes             Note[]
  mistakeNotebooks  MistakeNotebook[]
  flashcards        Flashcard[]
  notifications     Notification[]
  aiRequests        AIRequest[]
  auditLogs         AuditLog[]
  settings          AppSetting[]

  @@map("users")
}

model StudentProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  targetExamination     String?
  targetYear            Int?
  subjects              String[]
  dailyStudyGoal        Int?
  targetScore           Int?
  studySchedule         Json?
  readinessScore        Int       @default(0)
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastStudyDate         DateTime?
  totalStudyTime        BigInt    @default(0)
  totalQuestionsAttempted Int     @default(0)
  averageScore          Float     @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("student_profiles")
}

model ParentChild {
  id           String   @id @default(uuid())
  parentId     String
  studentId    String
  relationship String?
  createdAt    DateTime @default(now())

  parent  User @relation("ParentChild", fields: [parentId], references: [id])
  student User @relation("ChildParent", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@map("parent_children")
}

model School {
  id             String   @id @default(uuid())
  name           String
  address        String?
  domain         String?
  logo           String?
  branding       Json?
  subscriptionId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classes        Class[]
  members        SchoolMember[]

  @@map("schools")
}

model SchoolMember {
  id        String  @id @default(uuid())
  schoolId  String
  userId    String
  role      Role
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([schoolId, userId])
  @@map("school_members")
}

model Class {
  id         String   @id @default(uuid())
  name       String
  schoolId   String
  teacherId  String
  subjects   String[]
  studentCount Int    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school  School @relation(fields: [schoolId], references: [id])
  teacher User   @relation(fields: [teacherId], references: [id])

  @@map("classes")
}

model ExaminationBody {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  types     ExaminationType[]
  questions Question[]
  papers    ExaminationPaper[]

  @@map("examination_bodies")
}

model ExaminationType {
  id                String   @id @default(uuid())
  examinationBodyId String
  name              String
  code              String
  year              Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  body      ExaminationBody @relation(fields: [examinationBodyId], references: [id])
  questions Question[]
  papers    ExaminationPaper[]

  @@unique([examinationBodyId, code, year])
  @@map("examination_types")
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics    Topic[]
  questions Question[]
  papers    ExaminationPaper[]

  @@map("subjects")
}

model Topic {
  id          String   @id @default(uuid())
  subjectId   String
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id])
  questions Question[]

  @@unique([subjectId, name])
  @@map("topics")
}

model Question {
  id                String       @id @default(uuid())
  examinationBodyId String
  examinationTypeId String
  subjectId         String
  topicId           String
  type              QuestionType
  difficulty        Difficulty
  questionText      String
  options           Json?
  correctAnswer     String?
  explanation       String?
  marks             Float        @default(1)
  year              Int?
  tags              String[]
  metadata          Json?
  isPublished       Boolean      @default(false)
  reviewedBy        String?
  reviewedAt        DateTime?
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  body              ExaminationBody  @relation(fields: [examinationBodyId], references: [id])
  typeRelation      ExaminationType  @relation(fields: [examinationTypeId], references: [id])
  subject           Subject          @relation(fields: [subjectId], references: [id])
  topic             Topic            @relation(fields: [topicId], references: [id])
  sectionQuestions  ExamPaperSectionQuestion[]
  attempts          AttemptAnswer[]

  @@index([examinationBodyId, subjectId, topicId])
  @@index([type, difficulty])
  @@index([isPublished])
  @@map("questions")
}

model ExaminationPaper {
  id                String   @id @default(uuid())
  examinationBodyId String
  examinationTypeId String
  subjectId         String?
  title             String
  description       String?
  duration          Int
  totalMarks        Float
  instructions      String?
  sectionsJson       Json?
  isPublished       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  body      ExaminationBody @relation(fields: [examinationBodyId], references: [id])
  type      ExaminationType @relation(fields: [examinationTypeId], references: [id])
  subject   Subject?        @relation(fields: [subjectId], references: [id])
  sections  ExamPaperSection[]
  attempts  Attempt[]

  @@map("examination_papers")
}

model ExamPaperSection {
  id                String   @id @default(uuid())
  examinationPaperId String
  title             String
  instructions      String?
  duration          Int?
  order             Int
  createdAt         DateTime @default(now())

  paper     ExaminationPaper          @relation(fields: [examinationPaperId], references: [id])
  questions ExamPaperSectionQuestion[]

  @@map("exam_paper_sections")
}

model ExamPaperSectionQuestion {
  id          String   @id @default(uuid())
  sectionId   String
  questionId  String
  order       Int
  createdAt   DateTime @default(now())

  section  ExamPaperSection @relation(fields: [sectionId], references: [id])
  question Question         @relation(fields: [questionId], references: [id])

  @@unique([sectionId, questionId])
  @@map("exam_paper_section_questions")
}

model Attempt {
  id                  String    @id @default(uuid())
  userId              String
  examinationPaperId  String?
  mode                ExamMode
  answersJson          Json?
  score               Float?
  totalMarks          Float?
  timeSpent           Int       @default(0)
  timeRemaining       Int?
  startedAt           DateTime  @default(now())
  submittedAt         DateTime?
  isCompleted         Boolean   @default(false)
  isAutoSubmitted     Boolean   @default(false)
  timeManagementScore Float?
  readinessScore      Int?
  createdAt           DateTime  @default(now())

  user    User              @relation(fields: [userId], references: [id])
  paper   ExaminationPaper? @relation(fields: [examinationPaperId], references: [id])
  answers AttemptAnswer[]
  result  Result?

  @@map("attempts")
}

model AttemptAnswer {
  id             String   @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean?
  timeSpent      Int
  answerChanges  Int       @default(0)
  isFlagged      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  attempt  Attempt  @relation(fields: [attemptId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

model Result {
  id                String   @id @default(uuid())
  attemptId         String   @unique
  userId            String
  totalScore        Float
  totalMarks        Float
  percentageScore   Float
  grade             String?
  subjectBreakdown  Json?
  topicBreakdown    Json?
  timeAnalysis      Json?
  mistakeAnalysis   Json?
  recommendations   String[]
  createdAt         DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("results")
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@map("bookmarks")
}

model Note {
  id         String   @id @default(uuid())
  userId     String
  questionId String?
  title      String?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("notes")
}

model MistakeNotebook {
  id             String         @id @default(uuid())
  userId         String
  questionId     String
  selectedAnswer String?
  correctAnswer  String?
  category       MistakeCategory
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
  @@map("mistake_notebooks")
}

model Flashcard {
  id          String     @id @default(uuid())
  userId      String
  questionId  String?
  front       String
  back        String
  topicId     String?
  difficulty  Difficulty @default(MEDIUM)
  repetitions Int        @default(0)
  easeFactor  Float      @default(2.5)
  interval    Int        @default(0)
  nextReview  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, nextReview])
  @@map("flashcards")
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String             @unique
  plan            SubscriptionPlan
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime
  gracePeriodEnd  DateTime?
  autoRenew       Boolean            @default(true)
  paymentProvider PaymentProvider?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  subscriptionId    String?
  provider          PaymentProvider
  providerReference String        @unique
  transactionId     String?
  amount            Float
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  metadata          Json?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([provider, providerReference])
  @@map("payments")
}

model Coupon {
  id        String           @id @default(uuid())
  code      String           @unique
  type      String
  value     Float
  maxUses   Int?
  currentUses Int            @default(0)
  plan      SubscriptionPlan?
  expiresAt DateTime?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("coupons")
}

model Voucher {
  id          String   @id @default(uuid())
  code        String   @unique
  plan        SubscriptionPlan
  duration    Int
  maxUses     Int?
  currentUses Int      @default(0)
  schoolId    String?
  resellerId  String?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("vouchers")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model StudyPlan {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime
  dailyGoal       Int
  subjects        Json?
  recommendations String[]
  isCompleted     Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("study_plans")
}

model AIRequest {
  id        String     @id @default(uuid())
  userId    String
  feature   AIfeature
  prompt    String
  response  String?
  provider  String
  model     String
  tokensUsed Int       @default(0)
  cost      Float      @default(0)
  latency   Int        @default(0)
  isCached  Boolean    @default(false)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("ai_requests")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, entity])
  @@map("audit_logs")
}

model AppSetting {
  id        String   @id @default(uuid())
  userId    String?
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@map("app_settings")
}

model File {
  id          String   @id @default(uuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  bucket      String
  key         String
  url         String?
  uploadedBy  String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("files")
}
